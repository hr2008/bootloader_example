{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Debug STM32F407 with ST-Link",
            "type": "cortex-debug",
            "request": "launch",
            "servertype": "openocd",
            "device": "STM32F407VG",
            "cwd": "${workspaceFolder}",
            "executable": "${workspaceFolder}/build/bootloader.elf",
            "runToMain": true,
            "configFiles": [
                "interface/stlink.cfg",
                "target/stm32f4x.cfg"
            ],
            "showDevDebugOutput": true,
            "svdFile": "",
            "preLaunchTask": "build"
        },
            
    {
      "name": "ST-Link: Attach to Bootloader",
      "cwd": "${workspaceFolder}/bootloader",
      "executable": "${workspaceFolder}/build/bootloader.elf",
      "servertype": "stutil",
      "request": "attach",
      "type": "cortex-debug",
      "device": "STM32F407VG",
      "runToEntryPoint": "main",
      "interface": "swd",
    }
    ]
}
